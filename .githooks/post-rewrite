#!/bin/sh
# After git rebase or git pull --rebase: ORIG_HEAD is the tip before the rebase.
set -eu

# Git writes the rewritten commits to standard input; they are not needed.
cat >/dev/null

if [ "${1:-}" != rebase ]; then
    exit 0
fi

repository_root=$(git rev-parse --show-toplevel)
cd "$repository_root"

{ git diff --no-renames --name-only ORIG_HEAD HEAD 2>/dev/null || true; } \
    | sh scripts/git-hooks/generate-project.sh --soft

#!/bin/sh
# After switching branches: $1 and $2 are the previous and new HEAD, $3 is 1 for a branch checkout.
set -eu

if [ "${3:-0}" != 1 ] || [ "${1:-}" = "${2:-}" ]; then
    exit 0
fi

repository_root=$(git rev-parse --show-toplevel)
cd "$repository_root"

{ git diff --no-renames --name-only "$1" "$2" 2>/dev/null || true; } \
    | sh scripts/git-hooks/generate-project.sh --soft
